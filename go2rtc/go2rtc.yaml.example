# go2rtc configuration template.
#
# install.sh copies this to go2rtc.yaml on first run.  The live go2rtc.yaml is
# NOT tracked in git because go2rtc rewrites it at runtime: the backend
# registers each printer's camera via PUT /api/streams, and go2rtc persists
# every stream it is given back into this file.
#
# That means the `streams:` block below is intentionally empty — the backend is
# the source of truth for it and re-registers every printer on startup
# (see _go2rtc_put in backend/main.py).  Do not hand-write printer streams
# here; add the printer in the web UI instead.

api:
  listen: :1984
  origin: '*'

log:
  level: debug

rtsp:
  listen: :8554

# Populated at runtime by the backend — one entry per printer, named
# bambu_<printer id>, pointing at rtsps://bblp:<access code>@<ip>:322/...
streams: {}

webrtc:
  ice_servers:
  - urls:
    - stun:stun.l.google.com:19302
    - stun:stun1.l.google.com:19302
  listen: :8555/tcp
  # Addresses the browser is told to connect to for the video/audio stream.
  # Each one must be reachable *by the browser*, not by the Pi — so both the
  # LAN address and the Tailscale address are advertised, and the browser
  # picks whichever works.
  #
  # HOST_IP is the LAN IP of the machine running Docker (e.g. 192.168.1.50).
  # TS_IP is its Tailscale address (`tailscale ip -4`), or the same as
  # HOST_IP if you do not use Tailscale.
  #
  # Both are set in a .env file next to docker-compose.yml and substituted
  # here automatically; install.sh detects and writes them for you.
  #
  # A stale HOST_IP is the usual cause of "WebRTC connection failed": these
  # are DHCP leases, and when the Pi's address moves, go2rtc keeps offering
  # the old one. Re-run install.sh or fix .env, then restart go2rtc.
  candidates:
    - ${HOST_IP}:8555
    - ${TS_IP}:8555
