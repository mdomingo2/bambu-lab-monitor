# ============================================================
#  Bambu Lab Monitor — systemd service unit
#  Installed automatically by install.sh
#  Placeholders __APP_DIR__ and __USER__ are substituted
#  by the installer before copying to /etc/systemd/system/
# ============================================================
[Unit]
Description=Bambu Lab Monitor (Docker Compose stack)
Documentation=https://github.com/mdomingo2/bambu-lab-monitor
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=__USER__
WorkingDirectory=__APP_DIR__

# Bring the stack up (builds if images are missing)
ExecStart=/usr/bin/docker compose up -d --remove-orphans

# Gracefully stop all containers on service stop / reboot
ExecStop=/usr/bin/docker compose down

# Restart the whole stack if it exits unexpectedly
Restart=on-failure
RestartSec=10s

# Give containers up to 2 min to stop cleanly
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
