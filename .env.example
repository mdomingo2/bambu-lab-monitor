# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit it.

# LAN IP of the machine running Docker.
# The browser makes a direct connection to HOST_IP:8555 for WebRTC camera video.
# Without this set correctly, camera streams will show "WebRTC connection failed."
#
# How to find your machine's LAN IP:
#   Windows:  ipconfig  (look for IPv4 Address under your network adapter)
#   macOS:    ifconfig en0 | grep "inet "
#   Linux/Pi: hostname -I | awk '{print $1}'
#
HOST_IP=192.168.1.x

# Comma-separated IPs and/or hostnames to include in the HTTPS certificate's
# Subject Alternative Name (SAN).  Browsers validate the SAN, not just the CN —
# without this, the cert won't match your Pi's LAN address and browsers will
# reject it even after you've trusted/installed it.
#
# Set this to however you actually reach the Pi from your browser.
# Examples:
#   CERT_HOSTS=192.168.1.50
#   CERT_HOSTS=192.168.1.50,bambu-pi.local
#   CERT_HOSTS=192.168.1.50,bambu-pi.local,bambu.home
#
# After changing this you must delete the old cert and restart so a new one
# is generated (see DEPLOY.md → "Trusting the HTTPS Certificate").
#
CERT_HOSTS=192.168.1.x
