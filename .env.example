# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit it.

# LAN IP of the machine running Docker.
# The browser makes a direct connection to HOST_IP:8555 for WebRTC camera video.
# Without this set correctly, camera streams will show "WebRTC connection failed."
#
# How to find your machine's LAN IP:
#   Windows:  ipconfig  (look for IPv4 Address under your network adapter)
#   macOS:    ifconfig en0 | grep "inet "
#   Linux/Pi: hostname -I | awk '{print $1}'
#
HOST_IP=192.168.1.x
